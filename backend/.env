# Database (PostgreSQL на удалённом сервере)
# Замените your-server-ip на реальный IP вашего сервера
DATABASE_URL=postgresql+asyncpg://wordflow:wordflow123@your-server-ip:5432/wordflow

# JWT
JWT_SECRET=your-secret-key-change-in-production
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Lessons
WORDS_PER_LESSON=5
WORDS_PER_LESSON_MAX=10
DAILY_LESSON_LIMIT_DEFAULT=3
DAILY_LESSON_LIMIT_MAX=7

# GigaChat
GIGACHAT_AUTH_KEY=your-auth-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_CA_CERT_PATH=
GIGACHAT_MAX_CONCURRENCY=5

# LLM
GEN_TEMPERATURE=0.7
EVAL_TEMPERATURE=0.2
LLM_LOG_RETENTION_DAYS=90

# Admin
ADMIN_PASSWORD=admin123

# CORS - добавлены все возможные варианты
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5173
