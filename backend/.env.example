# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wordflow

# JWT
JWT_SECRET=your-secret-key-change-in-production
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Lessons
WORDS_PER_LESSON=5
DAILY_LESSON_LIMIT_DEFAULT=3
DAILY_LESSON_LIMIT_MAX=5

# GigaChat
GIGACHAT_AUTH_KEY=your-auth-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_CA_CERT_PATH=/path/to/root.crt
GIGACHAT_MAX_CONCURRENCY=5

# LLM
GEN_TEMPERATURE=0.7
EVAL_TEMPERATURE=0.2
LLM_LOG_RETENTION_DAYS=90

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
