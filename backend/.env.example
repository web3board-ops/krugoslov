# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wordflow

# JWT
JWT_SECRET=your-secret-key-change-in-production
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Lessons
WORDS_PER_LESSON=5
DAILY_LESSON_LIMIT_DEFAULT=3
DAILY_LESSON_LIMIT_MAX=5

# GigaChat
# Получить ключ авторизации: https://developers.sber.ru/docs/ru/gigachat/api/main
GIGACHAT_AUTH_KEY=your-auth-key
# Scope зависит от типа доступа:
# - GIGACHAT_API_PERS - физические лица
# - GIGACHAT_API_B2B - ИП и юрлица (пакеты токенов)
# - GIGACHAT_API_CORP - ИП и юрлица (pay-as-you-go)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модели: GigaChat, GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Ultra
GIGACHAT_MODEL=GigaChat
# Путь к корневому сертификату НУЦ Минцифры (обязательно для production)
# Скачать: https://gu-st.ru/content/lending/russian_trusted_root_ca.cer
# Для разработки оставьте пустым (SSL проверка отключена)
GIGACHAT_CA_CERT_PATH=
GIGACHAT_MAX_CONCURRENCY=5

# LLM
GEN_TEMPERATURE=0.7
EVAL_TEMPERATURE=0.2
LLM_LOG_RETENTION_DAYS=90

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5173
